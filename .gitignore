# Dependencies (bun install). bun.lock is committed; other managers' locks are not.
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build output: the GUI bundle (`bun run build`). Published packages ship it
# through package.json "files"; a by-path checkout builds it locally.
dist/

# TypeScript and tool caches
*.tsbuildinfo
.cache/
.eslintcache
coverage/
*.lcov

# Logs and runtime data
logs/
*.log
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
*.pid
*.pid.lock

# Output of `npm pack` / `bun pm pack`
*.tgz

# Secrets: environment files (keep a committed .env.example if you need one)
.env
.env.*
!.env.example

# OS and editor clutter
.DS_Store
Thumbs.db
.idea/
*.swp
